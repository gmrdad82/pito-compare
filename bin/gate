#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

if command -v shellcheck > /dev/null; then
  shellcheck bin/gate bin/images bin/docs-bundle
else
  echo "gate: shellcheck is not installed here, so the scripts are not linted"
fi
cargo fmt --check
cargo clippy --all-targets --locked -- -D warnings
cargo clippy --lib --no-default-features --locked -- -D warnings
cargo test --all-targets --locked
