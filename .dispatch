name = "pito-compare"
preset = "rust"

[gate]
fast = "cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings && cargo clippy --lib --no-default-features --locked -- -D warnings"
full = "bin/gate"

[commands]
build = "cargo build --release --locked"
release = ""
deploy = ""
install = ""

[[test_track.jobs]]
name = "gate"
command = "bin/gate"
